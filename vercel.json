{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run generate",
  "outputDirectory": ".output/public",
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "rabbitic.com" }], "destination": "https://butterbun.vercel.app/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.rabbitic.com" }], "destination": "https://butterbun.vercel.app/:path*", "permanent": true }
  ],
  "headers": [
    { "source": "/llms(.*).txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }] }
  ]
}
